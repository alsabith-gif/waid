<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap — tells Google every page on your site so it can find and
  index them quickly, instead of waiting to discover them on its own.

  IMPORTANT: replace https://www.waidshoes.com below with your real,
  live domain once you have one (it should exactly match the siteUrl
  you set in js/content.js and the Sitemap: line in robots.txt).

  After the site is live, submit this file's URL
  (https://yourdomain.com/sitemap.xml) in Google Search Console —
  see README.md for the full step-by-step.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.waidshoes.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.waidshoes.com/privacy.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://www.waidshoes.com/terms.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
